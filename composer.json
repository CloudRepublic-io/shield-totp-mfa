{
    "name": "cloudrepublic/shield-totp-mfa",
    "description": "Google/Microsoft Authenticator (TOTP) MFA action for CodeIgniter Shield, with remember-this-device support and a device management page.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "codeigniter4",
        "codeigniter",
        "shield",
        "mfa",
        "2fa",
        "totp",
        "authenticator",
        "google-authenticator"
    ],
    "homepage": "https://github.com/cloudrepublic-io/shield-totp-mfa",
    "authors": [
        {
            "name": "Steve Lyons",
            "email": "steve@cloudrepublic.io",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/cloudrepublic-io/shield-totp-mfa/issues",
        "source": "https://github.com/cloudrepublic-io/shield-totp-mfa"
    },
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.6",
        "codeigniter4/shield": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "TotpMfa\\": "src/"
        }
    },
    "minimum-stability": "stable"
}
